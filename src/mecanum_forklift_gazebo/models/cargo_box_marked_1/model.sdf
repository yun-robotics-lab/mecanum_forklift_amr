        <geometry><box><size>0.152 0.03 0.121</size></box></geometry>
        <material>
          <ambient>0.85 0.8 0.6 1</ambient>
          <diffuse>0.85 0.8 0.6 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>

    <link name="marker">
      <pose>-0.09 0 0.061 0 0 3.141593</pose>
      <inertial><mass>0.002</mass><inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="board">
