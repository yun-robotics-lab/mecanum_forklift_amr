      <inertial><mass>0.2</mass><inertia><ixx>0.000615</ixx><iyy>0.000615</iyy><izz>0.000750</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="box_col">
