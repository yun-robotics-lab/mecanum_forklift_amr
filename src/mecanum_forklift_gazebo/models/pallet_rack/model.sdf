<?xml version="1.0"?>
<!-- One rack bay. Usable level: top surface 0.060 m, 0.60 m clear width, 0.36 m deep, front = -y.
     The forks lift at most 0.12 m, so this is the only level a pallet can be put on. -->
<sdf version="1.8">
  <model name="pallet_rack">
    <static>true</static>
    <link name="link">
        <collision name="post0_col"><pose>-0.3125 -0.1675 0.22 0 0 0</pose><geometry><box><size>0.025 0.025 0.44</size></box></geometry></collision>
        <visual name="post0_vis"><pose>-0.3125 -0.1675 0.22 0 0 0</pose><geometry><box><size>0.025 0.025 0.44</size></box></geometry><material><ambient>0.15 0.3 0.65 1</ambient><diffuse>0.15 0.3 0.65 1</diffuse></material></visual>
        <collision name="post1_col"><pose>-0.3125 0.1675 0.22 0 0 0</pose><geometry><box><size>0.025 0.025 0.44</size></box></geometry></collision>
        <visual name="post1_vis"><pose>-0.3125 0.1675 0.22 0 0 0</pose><geometry><box><size>0.025 0.025 0.44</size></box></geometry><material><ambient>0.15 0.3 0.65 1</ambient><diffuse>0.15 0.3 0.65 1</diffuse></material></visual>
        <collision name="post2_col"><pose>0.3125 -0.1675 0.22 0 0 0</pose><geometry><box><size>0.025 0.025 0.44</size></box></geometry></collision>
        <visual name="post2_vis"><pose>0.3125 -0.1675 0.22 0 0 0</pose><geometry><box><size>0.025 0.025 0.44</size></box></geometry><material><ambient>0.15 0.3 0.65 1</ambient><diffuse>0.15 0.3 0.65 1</diffuse></material></visual>
        <collision name="post3_col"><pose>0.3125 0.1675 0.22 0 0 0</pose><geometry><box><size>0.025 0.025 0.44</size></box></geometry></collision>
        <visual name="post3_vis"><pose>0.3125 0.1675 0.22 0 0 0</pose><geometry><box><size>0.025 0.025 0.44</size></box></geometry><material><ambient>0.15 0.3 0.65 1</ambient><diffuse>0.15 0.3 0.65 1</diffuse></material></visual>
        <collision name="deck_col"><pose>0 0 0.054 0 0 0</pose><geometry><box><size>0.6 0.36 0.012</size></box></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="deck_vis"><pose>0 0 0.054 0 0 0</pose><geometry><box><size>0.6 0.36 0.012</size></box></geometry><material><ambient>0.85 0.5 0.1 1</ambient><diffuse>0.85 0.5 0.1 1</diffuse></material></visual>
        <collision name="top_col"><pose>0 0 0.434 0 0 0</pose><geometry><box><size>0.65 0.36 0.012</size></box></geometry></collision>
        <visual name="top_vis"><pose>0 0 0.434 0 0 0</pose><geometry><box><size>0.65 0.36 0.012</size></box></geometry><material><ambient>0.85 0.5 0.1 1</ambient><diffuse>0.85 0.5 0.1 1</diffuse></material></visual>
        <visual name="back_brace_vis"><pose>0 0.175 0.3 0 0 0</pose><geometry><box><size>0.6 0.01 0.02</size></box></geometry><material><ambient>0.15 0.3 0.65 1</ambient><diffuse>0.15 0.3 0.65 1</diffuse></material></visual>
    </link>
  </model>
</sdf>
