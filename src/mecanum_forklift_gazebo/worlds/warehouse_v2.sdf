<?xml version="1.0" ?>
<!-- Warehouse v2, 8 x 6 m: two rack bays (level at 0.060 m), floor pick and drop, two moving
     cylinders. The world name matches simple_warehouse.sdf so config/bridge_config.yaml works.
     Robot spawns at the origin looking along +x. The cylinders only move with
     dynamic_obstacles:=true (launch argument); otherwise they stay at the middle of their paths. -->
<sdf version="1.8">
  <world name="mecanum_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>

    <gravity>0 0 -9.81</gravity>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <light type="point" name="ceiling_light">
      <pose>0 0 3 0 0 0</pose>
      <diffuse>0.5 0.5 0.5 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>10</range><constant>0.6</constant><linear>0.05</linear><quadratic>0.01</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <surface><friction><ode><mu>50</mu></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material>
            <ambient>0.35 0.36 0.38 1</ambient>
            <diffuse>0.35 0.36 0.38 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="warehouse_structure">
      <static>true</static>
      <link name="link">
        <collision name="wall_n_col"><pose>0 3.05 0.25 0 0 0</pose><geometry><box><size>8.2 0.1 0.5</size></box></geometry></collision>
        <visual name="wall_n_vis"><pose>0 3.05 0.25 0 0 0</pose><geometry><box><size>8.2 0.1 0.5</size></box></geometry><material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse></material></visual>
        <collision name="wall_s_col"><pose>0 -3.05 0.25 0 0 0</pose><geometry><box><size>8.2 0.1 0.5</size></box></geometry></collision>
        <visual name="wall_s_vis"><pose>0 -3.05 0.25 0 0 0</pose><geometry><box><size>8.2 0.1 0.5</size></box></geometry><material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse></material></visual>
        <collision name="wall_e_col"><pose>4.05 0 0.25 0 0 0</pose><geometry><box><size>0.1 6.0 0.5</size></box></geometry></collision>
        <visual name="wall_e_vis"><pose>4.05 0 0.25 0 0 0</pose><geometry><box><size>0.1 6.0 0.5</size></box></geometry><material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse></material></visual>
        <collision name="wall_w_col"><pose>-4.05 0 0.25 0 0 0</pose><geometry><box><size>0.1 6.0 0.5</size></box></geometry></collision>
        <visual name="wall_w_vis"><pose>-4.05 0 0.25 0 0 0</pose><geometry><box><size>0.1 6.0 0.5</size></box></geometry><material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse></material></visual>
        <visual name="stripe_n_vis"><pose>0 2.999 0.05 0 0 0</pose><geometry><box><size>8.0 0.002 0.04</size></box></geometry><material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material></visual>
        <visual name="stripe_s_vis"><pose>0 -2.999 0.05 0 0 0</pose><geometry><box><size>8.0 0.002 0.04</size></box></geometry><material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material></visual>
        <visual name="start_0_vis"><pose>0 0.3 0.001 0 0 0</pose><geometry><box><size>0.7 0.03 0.002</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <visual name="start_1_vis"><pose>0 -0.3 0.001 0 0 0</pose><geometry><box><size>0.7 0.03 0.002</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <visual name="start_2_vis"><pose>0.35 0 0.001 0 0 0</pose><geometry><box><size>0.03 0.63 0.002</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <visual name="start_3_vis"><pose>-0.35 0 0.001 0 0 0</pose><geometry><box><size>0.03 0.63 0.002</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <visual name="dash_0_vis"><pose>-3.00 1.2 0.001 0 0 0</pose><geometry><box><size>0.18 0.03 0.002</size></box></geometry><material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material></visual>
        <visual name="dash_1_vis"><pose>-2.70 1.2 0.001 0 0 0</pose><geometry><box><size>0.18 0.03 0.002</size></box></geometry><material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material></visual>
        <visual name="dash_2_vis"><pose>-2.40 1.2 0.001 0 0 0</pose><geometry><box><size>0.18 0.03 0.002</size></box></geometry><material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material></visual>
        <visual name="dash_3_vis"><pose>-2.10 1.2 0.001 0 0 0</pose><geometry><box><size>0.18 0.03 0.002</size></box></geometry><material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material></visual>
        <visual name="dash_4_vis"><pose>-1.80 1.2 0.001 0 0 0</pose><geometry><box><size>0.18 0.03 0.002</size></box></geometry><material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material></visual>
        <visual name="dash_5_vis"><pose>-1.50 1.2 0.001 0 0 0</pose><geometry><box><size>0.18 0.03 0.002</size></box></geometry><material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material></visual>
        <visual name="dash_6_vis"><pose>-1.20 1.2 0.001 0 0 0</pose><geometry><box><size>0.18 0.03 0.002</size></box></geometry><material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material></visual>
        <visual name="dash_7_vis"><pose>-0.90 1.2 0.001 0 0 0</pose><geometry><box><size>0.18 0.03 0.002</size></box></geometry><material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material></visual>
        <visual name="dash_8_vis"><pose>-0.60 1.2 0.001 0 0 0</pose><geometry><box><size>0.18 0.03 0.002</size></box></geometry><material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material></visual>
        <visual name="dash_9_vis"><pose>-0.30 1.2 0.001 0 0 0</pose><geometry><box><size>0.18 0.03 0.002</size></box></geometry><material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material></visual>
        <visual name="dash_10_vis"><pose>0.00 1.2 0.001 0 0 0</pose><geometry><box><size>0.18 0.03 0.002</size></box></geometry><material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material></visual>
        <visual name="dash_11_vis"><pose>0.30 1.2 0.001 0 0 0</pose><geometry><box><size>0.18 0.03 0.002</size></box></geometry><material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material></visual>
        <visual name="dash_12_vis"><pose>0.60 1.2 0.001 0 0 0</pose><geometry><box><size>0.18 0.03 0.002</size></box></geometry><material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material></visual>
        <visual name="dash_13_vis"><pose>0.90 1.2 0.001 0 0 0</pose><geometry><box><size>0.18 0.03 0.002</size></box></geometry><material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material></visual>
        <visual name="dash_14_vis"><pose>1.20 1.2 0.001 0 0 0</pose><geometry><box><size>0.18 0.03 0.002</size></box></geometry><material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material></visual>
        <visual name="dash_15_vis"><pose>1.50 1.2 0.001 0 0 0</pose><geometry><box><size>0.18 0.03 0.002</size></box></geometry><material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material></visual>
        <visual name="dash_16_vis"><pose>1.80 1.2 0.001 0 0 0</pose><geometry><box><size>0.18 0.03 0.002</size></box></geometry><material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material></visual>
        <visual name="dash_17_vis"><pose>2.10 1.2 0.001 0 0 0</pose><geometry><box><size>0.18 0.03 0.002</size></box></geometry><material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material></visual>
        <visual name="dash_18_vis"><pose>2.40 1.2 0.001 0 0 0</pose><geometry><box><size>0.18 0.03 0.002</size></box></geometry><material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material></visual>
        <visual name="dash_19_vis"><pose>2.70 1.2 0.001 0 0 0</pose><geometry><box><size>0.18 0.03 0.002</size></box></geometry><material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material></visual>
        <visual name="dash_20_vis"><pose>3.00 1.2 0.001 0 0 0</pose><geometry><box><size>0.18 0.03 0.002</size></box></geometry><material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material></visual>
        <visual name="rackzone_0_0_vis"><pose>-1.1 1.85 0.001 0 0 0</pose><geometry><box><size>0.02 0.7 0.002</size></box></geometry><material><ambient>0.15 0.55 0.25 1</ambient><diffuse>0.15 0.55 0.25 1</diffuse></material></visual>
        <visual name="rackzone_0_1_vis"><pose>-0.5 1.85 0.001 0 0 0</pose><geometry><box><size>0.02 0.7 0.002</size></box></geometry><material><ambient>0.15 0.55 0.25 1</ambient><diffuse>0.15 0.55 0.25 1</diffuse></material></visual>
        <visual name="rackzone_0_2_vis"><pose>-0.8 1.5 0.001 0 0 0</pose><geometry><box><size>0.62 0.02 0.002</size></box></geometry><material><ambient>0.15 0.55 0.25 1</ambient><diffuse>0.15 0.55 0.25 1</diffuse></material></visual>
        <visual name="rackzone_1_0_vis"><pose>0.5 1.85 0.001 0 0 0</pose><geometry><box><size>0.02 0.7 0.002</size></box></geometry><material><ambient>0.15 0.55 0.25 1</ambient><diffuse>0.15 0.55 0.25 1</diffuse></material></visual>
        <visual name="rackzone_1_1_vis"><pose>1.1 1.85 0.001 0 0 0</pose><geometry><box><size>0.02 0.7 0.002</size></box></geometry><material><ambient>0.15 0.55 0.25 1</ambient><diffuse>0.15 0.55 0.25 1</diffuse></material></visual>
        <visual name="rackzone_1_2_vis"><pose>0.8 1.5 0.001 0 0 0</pose><geometry><box><size>0.62 0.02 0.002</size></box></geometry><material><ambient>0.15 0.55 0.25 1</ambient><diffuse>0.15 0.55 0.25 1</diffuse></material></visual>
        <visual name="pickzone_0_vis"><pose>0.9 0.28 0.001 0 0 0</pose><geometry><box><size>0.5 0.02 0.002</size></box></geometry><material><ambient>0.15 0.55 0.25 1</ambient><diffuse>0.15 0.55 0.25 1</diffuse></material></visual>
        <visual name="pickzone_1_vis"><pose>0.9 -0.28 0.001 0 0 0</pose><geometry><box><size>0.5 0.02 0.002</size></box></geometry><material><ambient>0.15 0.55 0.25 1</ambient><diffuse>0.15 0.55 0.25 1</diffuse></material></visual>
        <visual name="hatch_0_vis"><pose>2.65 -2.62 0.001 0 0 0.785</pose><geometry><box><size>0.04 0.5 0.002</size></box></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
        <visual name="hatch_1_vis"><pose>2.82 -2.62 0.001 0 0 0.785</pose><geometry><box><size>0.04 0.5 0.002</size></box></geometry><material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material></visual>
        <visual name="hatch_2_vis"><pose>2.99 -2.62 0.001 0 0 0.785</pose><geometry><box><size>0.04 0.5 0.002</size></box></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
        <visual name="hatch_3_vis"><pose>3.16 -2.62 0.001 0 0 0.785</pose><geometry><box><size>0.04 0.5 0.002</size></box></geometry><material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material></visual>
        <visual name="hatch_4_vis"><pose>3.33 -2.62 0.001 0 0 0.785</pose><geometry><box><size>0.04 0.5 0.002</size></box></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
        <visual name="hatch_5_vis"><pose>3.50 -2.62 0.001 0 0 0.785</pose><geometry><box><size>0.04 0.5 0.002</size></box></geometry><material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material></visual>
        <visual name="hatch_6_vis"><pose>3.67 -2.62 0.001 0 0 0.785</pose><geometry><box><size>0.04 0.5 0.002</size></box></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
        <visual name="hatch_7_vis"><pose>3.84 -2.62 0.001 0 0 0.785</pose><geometry><box><size>0.04 0.5 0.002</size></box></geometry><material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material></visual>
        <visual name="path_x_vis"><pose>-0.7 -1.3 0.0008 0 0 0</pose><geometry><box><size>3.0 0.04 0.0016</size></box></geometry><material><ambient>0.85 0.2 0.1 1</ambient><diffuse>0.85 0.2 0.1 1</diffuse></material></visual>
        <visual name="path_y_vis"><pose>2.2 0 0.0008 0 0 0</pose><geometry><box><size>0.04 2.4 0.0016</size></box></geometry><material><ambient>0.85 0.2 0.1 1</ambient><diffuse>0.85 0.2 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <!-- racks: A1 holds a pallet with marker 1, A2 is empty -->
    <include>
      <uri>model://pallet_rack</uri>
      <name>rack_a1</name>
      <pose>-0.8 2.4 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://pallet_rack</uri>
      <name>rack_a2</name>
      <pose>0.8 2.4 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://mini_pallet</uri>
      <name>pallet_rack_1</name>
      <pose>-0.8 2.29 0.060 0 0 0</pose>
    </include>
    <include>
      <uri>model://cargo_box_marked_1</uri>
      <name>box_rack_1</name>
      <pose>-0.8 2.29 0.116 0 0 1.570796</pose>
    </include>
    <!-- floor pick (same place as in simple_warehouse.sdf) -->
    <include>
      <uri>model://mini_pallet</uri>
      <name>pallet_1</name>
      <pose>0.9 0.0 0.0 0 0 1.570796</pose>
    </include>
    <include>
      <uri>model://cargo_box_marked</uri>
      <name>box_1</name>
      <pose>0.9 0.0 0.056 0 0 0</pose>
    </include>
    <!-- floor drop station and chargers -->
    <include>
      <uri>model://dropoff_station</uri>
      <name>dropoff_station</name>
      <pose>3.7 -2.0 0.0 0 0 3.141593</pose>
    </include>
    <include>
      <uri>model://charging_station</uri>
      <name>charging_station_1</name>
      <pose>-3.96 -1.6 0.0 0 0 0</pose>
    </include>
    <include>
      <uri>model://charging_station</uri>
      <name>charging_station_2</name>
      <pose>-3.96 1.6 0.0 0 0 0</pose>
    </include>
    <include>
      <uri>model://aruco_marker_4</uri>
      <name>marker_charging_1</name>
      <pose>-3.938 -1.6 0.24 0 0 0</pose>
    </include>
    <include>
      <uri>model://aruco_marker_5</uri>
      <name>marker_charging_2</name>
      <pose>-3.938 1.6 0.24 0 0 0</pose>
    </include>
    <include>
      <uri>model://aruco_marker_7</uri>
      <name>marker_dropoff_station</name>
      <pose>3.875 -2.0 0.075 0 0 3.141593</pose>
    </include>
    <!-- storage along the walls, scenery -->
    <include>
      <uri>model://shelf</uri>
      <name>shelf_s0</name>
      <pose>-2.4 -2.75 0.0 0 0 3.141593</pose>
    </include>
    <include>
      <uri>model://shelf</uri>
      <name>shelf_s1</name>
      <pose>-1.75 -2.75 0.0 0 0 3.141593</pose>
    </include>
    <include>
      <uri>model://shelf</uri>
      <name>shelf_s2</name>
      <pose>-1.1 -2.75 0.0 0 0 3.141593</pose>
    </include>
    <include>
      <uri>model://mini_pallet</uri>
      <name>stock_low</name>
      <pose>-2.4 -2.75 0.066 0 0 0</pose>
    </include>
    <include>
      <uri>model://cargo_box</uri>
      <name>stock_box</name>
      <pose>-1.1 -2.75 0.196 0 0 0</pose>
    </include>
    <include>
      <uri>model://mini_pallet</uri>
      <name>stock_floor</name>
      <pose>-3.2 2.5 0.0 0 0 1.570796</pose>
    </include>
    <include>
      <uri>model://cargo_box</uri>
      <name>stock_floor_box</name>
      <pose>-3.2 2.5 0.056 0 0 0</pose>
    </include>
    <include>
      <uri>model://safety_cone</uri>
      <name>cone_1</name>
      <pose>-2.6 0.9 0.0 0 0 0</pose>
    </include>
    <include>
      <uri>model://safety_cone</uri>
      <name>cone_2</name>
      <pose>-2.6 -0.9 0.0 0 0 0</pose>
    </include>
    <include>
      <uri>model://safety_cone</uri>
      <name>cone_3</name>
      <pose>3.2 1.6 0.0 0 0 0</pose>
    </include>
    <include>
      <uri>model://safety_cone</uri>
      <name>cone_4</name>
      <pose>3.2 0.6 0.0 0 0 0</pose>
    </include>
    <!-- moving obstacles: model pose = middle of the path -->
    <include>
      <uri>model://dynamic_cylinder_x</uri>
      <name>obstacle_x</name>
      <pose>-0.7 -1.3 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://dynamic_cylinder_y</uri>
      <name>obstacle_y</name>
      <pose>2.2 0.0 0 0 0 0</pose>
    </include>
  </world>
</sdf>
