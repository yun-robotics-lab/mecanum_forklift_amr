<?xml version="1.0"?>
<!-- Colours only. Iron Man palette: hot-rod red body, gold wheels/trim. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <material name="ironman_red"><color rgba="0.62 0.04 0.06 1"/></material>
  <material name="ironman_gold"><color rgba="0.92 0.69 0.13 1"/></material>
  <material name="wheel_hub_tan"><color rgba="0.85 0.78 0.52 1"/></material>
  <material name="wheel_roller_red"><color rgba="0.85 0.04 0.08 1"/></material>
  <material name="wheel_axle_grey"><color rgba="0.62 0.62 0.68 1"/></material>
  <material name="fork_grey"><color rgba="0.35 0.35 0.38 1"/></material>
  <material name="sensor_black"><color rgba="0.05 0.05 0.05 1"/></material>
</robot>
