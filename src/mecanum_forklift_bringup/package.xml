<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mecanum_forklift_bringup</name>
  <version>0.0.0</version>
  <description>Bringup for one or several namespaced mecanum forklifts: fleet file, world + per-robot spawn and bridge launch, per-robot stack launch with a readiness gate</description>
  <maintainer email="yinchheanyun21@gmail.com">yinchheanyun</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>mecanum_forklift_description</exec_depend>
  <exec_depend>mecanum_forklift_gazebo</exec_depend>
  <exec_depend>mecanum_forklift_control</exec_depend>
  <exec_depend>mecanum_forklift_lift</exec_depend>
  <exec_depend>mecanum_forklift_localization</exec_depend>
  <exec_depend>mecanum_forklift_navigation</exec_depend>
  <exec_depend>mecanum_forklift_vision</exec_depend>
  <exec_depend>mecanum_forklift_docking</exec_depend>
  <exec_depend>mecanum_forklift_task_manager</exec_depend>
  <exec_depend>mecanum_forklift_web_bridge</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
